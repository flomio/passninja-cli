{
  "compileOnSave": false,
  "include": ["./lib/**/*", "./bin/**/*"],
  "exclude": ["./no_compile/**/*"],
  "compilerOptions": {
    "baseUrl": "./",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "./build",
    "sourceMap": true,
    "declaration": false,
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es6",
    "types": ["node", "jasmine"],
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2018", "dom"]
  }
}
