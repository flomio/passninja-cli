{
  "compileOnSave": false,
  "include": [
    "./lib/**/*",
    "./bin/**.*",
    "aws/deploy.ts",
    "no_compile/compiled-src/pn.js",
    "no_compile/setupScanner.ts",
    "no_compile/CleanUp.ts",
    "no_compile/AuthorizationService.spec.ts",
    "lib/AuthorizationService.ts",
    "no_compile/config.ts"
  ],
  "exclude": ["./no_compile/**/*"],
  "compilerOptions": {
    "baseUrl": "./",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "./build",
    "sourceMap": true,
    "declaration": false,
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es6",
    "types": ["node", "jasmine"],
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2018", "dom"]
  }
}
