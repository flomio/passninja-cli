{
  "name": "pn-cli-cloud",
  "private": true,
  "version": "0.0.0",
  "bin": {
    "pn": "./dist/pn.js"
  },
  "entry point": "bin/pn.js",
  "scripts": {
    "build": "node_modules/.bin/webpack",
    "preinstall": "rm -f package-lock.json && rm -rf node_modules",
    "start": "npm run ts -- bin/pn",
    "ts": "node_modules/.bin/ts-node",
    "test": "node_modules/.bin/jest",
    "lint": "tslint --project tslint.json"
  },
  "dependencies": {
    "@types/node-forge": "^0.8.2",
    "amazon-cognito-identity-js": "^3.0.12",
    "apple-vas-data-decrypt": "git+https://github.com/flomio/apple-vas-data-decrypt",
    "aws-iot-device-sdk": "^2.2.1",
    "aws-sdk": "^2.439.0",
    "base-x": "^3.0.5",
    "bufferutil": "^4.0.1",
    "commander": "^2.20.0",
    "debug": "^4.1.1",
    "flomio-js-sdk": "file:../flomio-js-sdk",
    "flomio-js-sdk-pcsc": "file:../flomio-js-sdk-pcsc",
    "mqtt": "^2.18.8",
    "node-fetch": "^2.6.0",
    "node-forge": "^0.8.2",
    "pcsclite": "^0.6.0",
    "readdir-cluster": "^1.1.0",
    "request": "^2.88.0",
    "request-promise-native": "^1.0.7",
    "rxjs": "~6.3.3",
    "shortid": "^2.2.14",
    "smart-tap": "git+https://github.com/flomio/smart-tap",
    "tslint": "^5.16.0",
    "utf-8-validate": "^5.0.2",
    "uuid": "^3.3.2",
    "window-mock": "^0.1.0"
  },
  "devDependencies": {
    "@types/aws-iot-device-sdk": "^2.2.0",
    "@types/base-x": "^3.0.0",
    "@types/commander": "^2.12.2",
    "@types/debug": "^4.1.4",
    "@types/jest": "^24.0.14",
    "@types/node": "^8.9.5",
    "@types/request-promise-native": "^1.0.15",
    "@types/shortid": "0.0.29",
    "@types/uuid": "^3.4.4",
    "clean-webpack-plugin": "^2.0.1",
    "cloudform": "^4.0.0-alpha.0",
    "dotenv": "^7.0.0",
    "fork-ts-checker-webpack-plugin": "^1.2.0",
    "jest": "^24.8.0",
    "nodemon": "^1.18.11",
    "nodemon-webpack-plugin": "^4.0.8",
    "shebang-loader": "0.0.1",
    "ts-jest": "^24.0.2",
    "ts-loader": "^5.4.3",
    "ts-node": "^7.0.1",
    "tslint-config-standard": "^8.0.1",
    "typescript": "^3.4.5",
    "webpack": "^4.30.0",
    "webpack-cli": "^3.3.1"
  },
  "nodemon": {
    "watch": [
      "lib",
      "bin"
    ],
    "exec": "npm run tsc && npm run test",
    "delay": 1000
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": "(lib|bin)\\/.*\\.(spec|test)\\.ts$"
  }
}
