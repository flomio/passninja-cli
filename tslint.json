{
  "extends": "tslint-config-standard",
  "rules": {
    "no-trailing-whitespace": false,
    "no-default-export": true,
    "prefer-const": true,
    "semicolon": false,
    "space-before-function-paren": false,
    "no-extra-boolean-cast": false
  },
  "linterOptions": {
    "exclude": ["./no_compile/**/*", "./no_compile/*"]
  }
}
